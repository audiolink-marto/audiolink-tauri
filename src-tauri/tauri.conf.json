{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AudioLink Ensayo",
  "version": "0.1.0",
  "identifier": "com.audiolink.ensayo.pilot",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "principal",
        "title": "AudioLink — Ensayo",
        "url": "https://audiolink-marto.github.io/AUDIOLINK/ensayo.html",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico"
    ]
  }
}
